@model AssetManagement.Models.Asset

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>
<a asp-action="Index">Back to List</a>

<div>
    <h4>Asset</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SerialNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SerialNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Category)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Category.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PurchaseDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PurchaseDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Notes)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Notes)
        </dd>
        <dt class="col-sm-2">
            Current Assignment
        </dt>
        <dd class="col-sm-10">
            @if (Model.CurrentAssignment != null)
            {
                <div>
                    @(Model.CurrentAssignment?.GetAssignedToName()) - Assigned on 
                    @(Model.CurrentAssignment?.AssignedAt)
                </div>
            }
        </dd>
        <dt class="col-sm-2">
            Assignment History
        </dt>
        <dd class="col-sm-10">
            @foreach (var assignment in Model.Assignments.Reverse())
            {
                <div>
                    @assignment.GetAssignedToName(): @assignment.AssignedAt - @assignment.ReturnedAt 
                     | <a asp-controller="Assignments" asp-action="Details" asp-route-id="@assignment.Id">View Details</a>
                </div>
            }
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CurrentMaintenance)
        </dt>
        <dd class="col-sm-10">
            @if (Model.CurrentMaintenance != null)
            {
                <div>
                    @(Model.CurrentMaintenance?.Technician?.Name) - Assigned on
                    @(Model.CurrentMaintenance?.StartedAt)
                </div>
            }   
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MaintenanceStatus)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaintenanceStatus)
        </dd>
        <dt class="col-sm-2">
            Maintenance History
        </dt>
        <dd class="col-sm-10">
            @foreach (var maintenance in Model.MaintenanceLogs.Reverse())
            {
                <div>
                    @maintenance.Technician.Name: @maintenance.StartedAt - @maintenance.CompletedAt
                    | <a asp-controller="MaintenanceAssignments" asp-action="Details" asp-route-id="@maintenance.Id">View Details</a>
                </div>
            }
        </dd>
    </dl>
    <hr />
    @if (Model?.CurrentAssignment != null)
    {
        <a asp-controller="Assignments"
           asp-action="Return"
           asp-route-id="@Model?.CurrentAssignment?.Id"
           asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
           class="btn btn-primary btn-sm"
        >
            Return Current Assignment
        </a>
    } else
    {
        <a class="btn btn-primary btn-sm disabled">
            Return Current Assignment
        </a>
    }

    <a 
        asp-controller="Assignments" 
        asp-action="Create" 
        asp-route-assetId="@Model?.Id"
        asp-route-date="@DateTime.Now"
        asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
        class="btn btn-primary btn-sm"
    >
        + Add Assignment
    </a>

    @* @if (Model?.CurrentAssignment != null)
    {
        <a asp-controller="Assignments"
           asp-action="Create"
           asp-route-assetId="@Model?.Id"
           asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
           class="btn btn-primary btn-sm">
            + Add Assignment
        </a>
    }
    else
    {
        <a class="btn btn-primary btn-sm disabled">
            Return Current Assignment
        </a>
    } *@
</div>
<div>
    <button class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@Model?.Id">Edit</button>
</div>
