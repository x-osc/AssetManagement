@model AssetManagement.Models.Asset

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>
<a asp-action="Index">Back to List</a>

<div>
    <h4>Asset</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SerialNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SerialNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Category)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Category.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PurchaseDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PurchaseDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Notes)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Notes)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Assignments)
        </dt>
        <dd class="col-sm-10">
            @if (Model.CurrentAssignment != null)
            {
                <div>
                    @(Model.CurrentAssignment?.GetAssignedToName()) - Assigned on 
                    @(Model.CurrentAssignment?.AssignedAt)
                </div>
            }
        </dd>
    </dl>
    <hr />
    <a asp-controller="Assignments"
       asp-action="Return"
       asp-route-id="@Model?.CurrentAssignment?.Id"
       asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
       class="btn btn-primary btn-sm">
        Return Current Assignment
    </a>
    <a 
        asp-controller="Assignments" 
        asp-action="Create" 
        asp-route-assetId="@Model?.Id" 
        asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
        class="btn btn-primary btn-sm"
    >
        + Add Assignment
    </a>
</div>
<div>
    <button class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@Model?.Id">Edit</button>
</div>
