@model AssetManagement.Controllers.AssetsController.AssetIndexViewModel;

@{
    ViewData["Title"] = "Index";
}

<h1>Assets</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sort="@(Model.Filter.GetNextOrder("serial") == null ? null : "serial")" asp-route-order="@Model.Filter.GetNextOrder("serial")">
                    @Html.DisplayNameFor(model => model.Assets[0].SerialNumber)
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sort="@(Model.Filter.GetNextOrder("name") == null ? null : "name")" asp-route-order="@Model.Filter.GetNextOrder("name")">
                    @Html.DisplayNameFor(model => model.Assets[0].Name)
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sort="@(Model.Filter.GetNextOrder("category") == null ? null : "category")" asp-route-order="@Model.Filter.GetNextOrder("category")">
                    @Html.DisplayNameFor(model => model.Assets[0].Category)
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sort="@(Model.Filter.GetNextOrder("status") == null ? null : "status")" asp-route-order="@Model.Filter.GetNextOrder("status")">
                    @Html.DisplayNameFor(model => model.Assets[0].Status)
                </a>
            </th>
            <th>
                Maintenance Status
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Assets) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SerialNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @switch (item.GetStatus())
                {
                    case MaintenanceStatus.NotStarted:
                        <span>Not Started</span>
                        break;
                    case MaintenanceStatus.InProgress:
                        <span>In Progress</span>
                        break;
                    case MaintenanceStatus.Completed:
                        <span>Completed</span>
                        break;
                    default:
                        <span>None</span>
                        break;
                }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
