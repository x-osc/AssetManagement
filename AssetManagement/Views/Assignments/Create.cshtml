@model AssetManagement.Models.Assignment

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Assignment</h4>
<hr />
@if (ViewData["Date"] != null)
{
    <p>Assigned Date: @ViewData["Date"]</p>
}
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>           
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            @if (Model.AssetId != 0)
            {
                <h5>Assignment for Asset: @Model.Asset?.Name</h5>
                <input type="hidden" asp-for="AssetId" />
            }
            else
            {
                <div class="form-group">
                    <label asp-for="AssetId" class="control-label"></label>
                    <select asp-for="AssetId" class ="form-control" asp-items="ViewBag.AssetId"></select>
                </div>
            }
            <div class="form-group">
                <label asp-for="PersonId" class="control-label"></label>
                <select asp-for="PersonId" class ="form-control" asp-items="ViewBag.PersonId">
                    <option value="">None</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="LocationId" class="control-label"></label>
                <select asp-for="LocationId" class ="form-control" asp-items="ViewBag.LocationId">
                    <option value="">None</option>
                </select>
            </div>
            @if (ViewData["Date"] != null)
            {
                <input type="hidden" asp-for="AssignedAt" value="@ViewData["Date"]" />
            } else
            {
                <div class="form-group">
                    <label asp-for="AssignedAt" class="control-label"></label>
                    <input asp-for="AssignedAt" class="form-control" />
                    <span asp-validation-for="AssignedAt" class="text-danger"></span>
                </div>
            }
            <div class="form-group">
                <label asp-for="Notes" class="control-label"></label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
